# Copy this file to .env.local for local development, and add the same
# variables in your host's environment-variables settings (see README.md
# "Deploying" for Vercel and Hostinger specifics).

# Public production URL (no trailing slash). Used for canonical URLs, the
# sitemap, robots.txt, Open Graph tags and structured data.
# TODO: set to the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.blazejunkandhaul.com

# Resend (https://resend.com) — delivers estimate-form submissions by email.
# If RESEND_API_KEY is missing: in development, submissions are logged to the
# terminal; in production the API returns an error so leads are never silently lost.
RESEND_API_KEY=

# Inbox that receives new estimate requests. Defaults to siteConfig.email.
CONTACT_TO_EMAIL=

# Verified Resend sender, e.g. "Blaze Website <leads@blazejunkandhaul.com>".
# Until a domain is verified in Resend you can use "onboarding@resend.dev".
CONTACT_FROM_EMAIL=
